---
import App from '../App.tsx';
import '../index.css';
import '../App.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/imgs/Exclude.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Canonical & Alternate Languages -->
    <link rel="canonical" href="https://saccadafia.com/" />
    <link rel="alternate" hreflang="fr" href="https://saccadafia.com/" />
    <link rel="alternate" hreflang="en" href="https://saccadafia.com/" />
    <link rel="alternate" hreflang="x-default" href="https://saccadafia.com/" />

    <!-- Robots & Indexing Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Title & Meta Description (Recruiter Clarity & SEO) -->
    <title>Sacca Dafia | Conception de Solutions & Produits Numériques</title>
    <meta name="description" content="Sacca Dafia, Product & Solution Designer (+4 ans d'expérience). Conception de solutions digitales complètes, plateformes SaaS B2B & produits numériques pour entreprises et startups. Contact: dafiashalom@gmail.com" />
    <meta name="author" content="Sacca Dafia" />
    <meta name="keywords" content="Sacca Dafia, Product Designer, Solution Designer, UX Designer, UI Designer, Web Designer, SaaS B2B, Solutions Numériques, Digital Products, Portfolio, Design System" />
    
    <!-- Security Headers Meta (CSP, Frame Options, Referrer Policy) -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://assets.calendly.com https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://assets.calendly.com https://api.calendly.com; frame-src 'self' https://calendly.com https://assets.calendly.com; frame-ancestors 'self';" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sacca Dafia | Portfolio" />
    <meta property="og:url" content="https://saccadafia.com/" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content="Sacca Dafia | Conception de Solutions & Produits Numériques" />
    <meta property="og:description" content="Product & Solution Designer (+4 ans d'expérience). Conception de solutions digitales sur mesure, SaaS B2B et produits numériques d'exception." />
    <meta property="og:image" content="https://saccadafia.com/imgs/og-preview.png?v=2" />
    <meta property="og:image:secure_url" content="https://saccadafia.com/imgs/og-preview.png?v=2" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Sacca Dafia - Conception de Solutions & Produits Numériques" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sacca Dafia | Conception de Solutions & Produits Numériques" />
    <meta name="twitter:description" content="Conception de produits numériques complets, plateformes SaaS B2B et solutions web stratégiques (+4 ans exp)." />
    <meta name="twitter:image" content="https://saccadafia.com/imgs/og-preview.png?v=2" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Caveat:wght@400..700&display=swap" rel="stylesheet">
    
    <!-- Calendly link widget -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
    
    <!-- JSON-LD Structured Data Graph for Person, WebSite & Case Studies -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://saccadafia.com/#person",
            "name": "Sacca Dafia",
            "jobTitle": "Product & Experience Designer",
            "description": "Product & Experience Designer spécialisé dans la conception de SaaS B2B, interfaces complexes et expériences web sur mesure.",
            "email": "dafiashalom@gmail.com",
            "telephone": "+2290160359022",
            "url": "https://saccadafia.com",
            "image": "https://saccadafia.com/imgs/hero_image.png",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Cotonou",
              "addressCountry": "BJ"
            },
            "sameAs": [
              "https://www.linkedin.com/in/dafia-s-860290218/",
              "https://github.com/shalomtalesman",
              "https://www.behance.net/shalomsacca"
            ],
            "knowsAbout": [
              "Product Design",
              "UX/UI Design",
              "SaaS B2B",
              "Web Design",
              "Design Systems",
              "Prototyping",
              "Information Architecture"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://saccadafia.com/#website",
            "url": "https://saccadafia.com/",
            "name": "Sacca Dafia | Portfolio - Product & Experience Designer",
            "description": "Portfolio de Sacca Dafia, Product & Experience Designer avec plus de 3 ans d'expérience.",
            "inLanguage": ["fr", "en"],
            "publisher": {
              "@id": "https://saccadafia.com/#person"
            }
          },
          {
            "@type": "ItemList",
            "name": "Études de cas & Projets SaaS B2B",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Asset IQ - Plateforme SaaS B2B & Dashboard",
                "url": "https://saccadafia.com/#asset-iq"
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": "eHadj - SaaS d'Orchestration Logistique",
                "url": "https://saccadafia.com/#ehadj"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": "Beans - SaaS B2B de Fidélisation Client",
                "url": "https://saccadafia.com/#beans"
              },
              {
                "@type": "ListItem",
                "position": 4,
                "name": "Truvox Studio - Web Design & Brand Experience",
                "url": "https://www.truvox.studio/"
              },
              {
                "@type": "ListItem",
                "position": 5,
                "name": "Sagana - Agence Digitale & Design System",
                "url": "https://saccadafia.com/#sagana"
              }
            ]
          }
        ]
      }
    </script>
  </head>
  <body>
    <!-- Accessibility Skip Link & Semantic Main Landmark Wrapper -->
    <a href="#main-content" className="skip-to-content-btn">Aller au contenu principal</a>
    
    <div style="display: none;">
      <article itemscope itemtype="https://schema.org/Person">
        <h1 itemprop="name">Sacca Dafia</h1>
        <h2 itemprop="jobTitle">Product & Experience Designer</h2>
        <p itemprop="description">Je conçois des produits numériques intuitifs, des SaaS B2B performants et des expériences web sur mesure (+4 ans d'expérience).</p>
        
        {/* Contact info & Social links */}
        <a href="mailto:dafiashalom@gmail.com" itemprop="email" rel="me">dafiashalom@gmail.com</a>
        <a href="tel:+2290160359022" itemprop="telephone" rel="me">+229 01 60 35 90 22</a>
        <a href="https://www.linkedin.com/in/dafia-s-860290218/" itemprop="sameAs" rel="me">LinkedIn: https://www.linkedin.com/in/dafia-s-860290218/</a>
        <a href="https://github.com/shalomtalesman" itemprop="sameAs" rel="me">GitHub: https://github.com/shalomtalesman</a>
        <a href="https://www.behance.net/shalomsacca" itemprop="sameAs" rel="me">Behance: https://www.behance.net/shalomsacca</a>

        {/* Section Projets et Liens de preuve */}
        <section id="projets" aria-label="Section Projets et Études de cas">
          <h2>Projets & Études de cas</h2>
          <ul>
            <li>
              <h3>Asset IQ - Plateforme SaaS B2B & Dashboard</h3>
              <p>Contexte &amp; Contribution : Système intelligent de suivi et gouvernance opérationnelle de ressources physiques multi-sites. Rôle : Stratégiste Produit &amp; UX.</p>
              <p>Résultat : -30% de temps d'arrêt, télémétrie en temps réel.</p>
              <a href="#asset-iq" rel="bookmark">Preuve / Étude de cas Asset IQ</a>
            </li>
            <li>
              <h3>eHadj - SaaS d'Orchestration Logistique</h3>
              <p>Contexte &amp; Contribution : Digitalisation globale de l'organisation du pèlerinage (inscriptions, logistique, transports, flux financiers). Rôle : Lead Product Designer.</p>
              <p>Résultat : +45% d'efficacité logistique et réservation centralisée.</p>
              <a href="#ehadj" rel="bookmark">Preuve / Étude de cas eHadj</a>
            </li>
            <li>
              <h3>Beans - SaaS B2B de Fidélisation Client & Customer Engagement</h3>
              <p>Contexte &amp; Contribution : Plateforme SaaS de fidélisation permettant aux marques e-commerce de créer des programmes de récompenses personnalisés et de booster la rétention client (Shopify, Klaviyo, POS). Rôle : Lead Product Designer.</p>
              <p>Résultat : Expérience SaaS unifiée, tunnel No-Code de règles de fidélité et analytics de rétention.</p>
              <a href="#beans" rel="bookmark">Preuve / Étude de cas Beans</a>
            </li>
            <li>
              <h3>Truvox Studio - Web Design & Brand Experience</h3>
              <p>Contexte &amp; Contribution : Studio d'expériences numériques apportant clarté, confiance et croissance aux entreprises. Rôle : Product &amp; Web Designer.</p>
              <a href="https://www.truvox.studio/" target="_blank" rel="noopener noreferrer me">Preuve / Site Truvox Studio: https://www.truvox.studio/</a>
            </li>
            <li>
              <h3>Dolce Riviera - E-commerce & Luxe</h3>
              <p>Contexte &amp; Contribution : Expérience de marque haut de gamme et boutique e-commerce immersive. Rôle : Product &amp; UI Designer.</p>
              <a href="#dolce-riviera" rel="bookmark">Preuve / Étude de cas Dolce Riviera</a>
            </li>
            <li>
              <h3>Sagana - Agence Digitale & Design System</h3>
              <p>Contexte &amp; Contribution : Plateforme web et design system modulable pour agence digitale. Rôle : UX/UI Designer.</p>
              <a href="#sagana" rel="bookmark">Preuve / Étude de cas Sagana</a>
            </li>
            <li>
              <h3>Vortex Gallery - Expérience Immersive Web3</h3>
              <p>Contexte &amp; Contribution : Galerie d'art numérique interactive. Rôle : Lead Designer.</p>
              <a href="#vortex" rel="bookmark">Preuve / Étude de cas Vortex Gallery</a>
            </li>
            <li>
              <h3>Sport Advisor - App & Plateforme Sportive</h3>
              <p>Contexte &amp; Contribution : Application de recommandation et coaching sportif personnalisé. Rôle : UX Designer.</p>
              <a href="#sport-advisor" rel="bookmark">Preuve / Étude de cas Sport Advisor</a>
            </li>
          </ul>
        </section>

        {/* Section Stack Technique & Compétences */}
        <section id="stack-technique" aria-label="Stack technique et compétences">
          <h2>Stack Technique &amp; Compétences</h2>
          <ul className="stack-technique">
            <li>Figma (UI/UX, Prototypage, Design Systems)</li>
            <li>React.js / Next.js / TypeScript</li>
            <li>Tailwind CSS / HTML5 / CSS3</li>
            <li>GSAP / Framer Motion (Animations Web)</li>
            <li>Astro / Vite</li>
            <li>Git / GitHub (Contrôle de version)</li>
            <li>Architecture de l'information &amp; Product Thinking</li>
            <li>Audit UX &amp; Tests utilisateurs</li>
          </ul>
        </section>
      </div>

      <App client:load />
    </div>
  </body>
</html>
