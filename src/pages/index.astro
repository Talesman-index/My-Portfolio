---
import App from '../App.tsx';
import '../index.css';
import '../App.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/imgs/Exclude.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Title & Meta Description (Recruiter Clarity & SEO) -->
    <title>Sacca Dafia | Portfolio - Product & Experience Designer</title>
    <meta name="description" content="Sacca Dafia, Product & Experience Designer (+3 ans d'expérience). Concepteur d'interfaces Web & SaaS B2B intuitives et performantes pour entreprises et startups. Contact: dafiashalom@gmail.com" />
    <meta name="author" content="Sacca Dafia" />
    <meta name="keywords" content="Sacca Dafia, Product Designer, UX Designer, UI Designer, Web Designer, SaaS B2B, Portfolio, Design System" />
    
    <!-- Security Headers Meta (CSP, Frame Options, Referrer Policy) -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://assets.calendly.com https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://assets.calendly.com https://api.calendly.com; frame-src 'self' https://calendly.com https://assets.calendly.com; frame-ancestors 'self';" />
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sacca Dafia | Portfolio - Product & Experience Designer" />
    <meta property="og:description" content="Product & Experience Designer avec 3+ ans d'expérience en design de SaaS B2B et produits numériques." />
    <meta property="og:image" content="/imgs/hero_image.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Sacca Dafia | Portfolio - Product & Experience Designer" />
    <meta name="twitter:description" content="Product & Experience Designer. Découvrez mes études de cas SaaS B2B et projets web." />
    <meta name="twitter:image" content="/imgs/hero_image.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&family=Caveat:wght@400..700&display=swap" rel="stylesheet">
    
    <!-- Calendly link widget -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
    
    <!-- JSON-LD Structured Data for Person & Recruiter Discovery -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Sacca Dafia",
        "jobTitle": "Product Designer & Experience Designer",
        "email": "dafiashalom@gmail.com",
        "telephone": "+2290160359022",
        "url": "https://saccadafia.com",
        "sameAs": [
          "https://www.linkedin.com/in/dafia-s-860290218/",
          "https://github.com/shalomtalesman",
          "https://www.behance.net/shalomsacca"
        ],
        "knowsAbout": ["Product Design", "UX/UI Design", "SaaS B2B", "Web Design", "Design Systems"]
      }
    </script>
  </head>
  <body>
    <div id="app-root">
      <App client:only="react" />
    </div>
  </body>
</html>
